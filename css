/* =========================
   SPA OJAS – Global Styles
   ========================= */

/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Body */
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  background-color: #f7f9f8;
  color: #2e2e2e;
  line-height: 1.8;
  font-size: 16px;
}

/* Container */
main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 40px 20px;
}

/* =========================
   Header
   ========================= */

header {
  background: #0f3d2e; /* deep green */
  color: #ffffff;
  padding: 70px 20px;
  text-align: center;
}

header h1 {
  font-size: 42px;
  font-weight: 700;
  letter-spacing: 1px;
}

/* =========================
   Sections
   ========================= */

section {
  background: #ffffff;
  margin-bottom: 40px;
  padding: 40px;
  border-radius: 12px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
}

/* H2 */
section h2 {
  font-size: 28px;
  margin-bottom: 20px;
  color: #0f3d2e;
  position: relative;
}

section h2::after {
  content: "";
  width: 60px;
  height: 3px;
  background: #c8a951; /* gold accent */
  display: block;
  margin-top: 10px;
}

/* Paragraph */
section p {
  margin-bottom: 18px;
  font-size: 17px;
}

/* =========================
   Lists
   ========================= */

ul {
  padding-left: 20px;
}

li {
  margin-bottom: 10px;
  font-size: 17px;
}

/* =========================
   Links
   ========================= */

a {
  color: #0f3d2e;
  text-decoration: none;
  font-weight: 600;
}

a:hover {
  color: #c8a951;
  text-decoration: underline;
}

/* =========================
   Images
   ========================= */

img {
  max-width: 100%;
  height: auto;
  border-radius: 10px;
  margin: 25px 0;
}

/* =========================
   Footer
   ========================= */

footer {
  background: #0f3d2e;
  color: #ffffff;
  text-align: center;
  padding: 40px 20px;
  font-size: 15px;
}

footer p {
  opacity: 0.9;
}

/* =========================
   Buttons (Future use)
   ========================= */

.button {
  display: inline-block;
  background: #c8a951;
  color: #0f3d2e;
  padding: 14px 30px;
  border-radius: 50px;
  font-weight: 700;
  transition: all 0.3s ease;
}

.button:hover {
  background: #b7963f;
  color: #ffffff;
}

/* =========================
   Responsive
   ========================= */

@media (max-width: 768px) {
  header h1 {
    font-size: 32px;
  }

  section {
    padding: 30px 20px;
  }

  section h2 {
    font-size: 24px;
  }

  main {
    padding: 20px 15px;
  }
}
